# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Match data: licensed for the competition only, never committed
data/

# Tool caches
.pytest_cache/
.ruff_cache/

